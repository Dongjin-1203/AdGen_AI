# ============================================
# AdGen AI - GPU 서버 환경 설정
# ============================================

# ===== Environment =====
ENVIRONMENT=production
DEBUG=False

# ===== Server =====
HOST=0.0.0.0
PORT=8001

# ===== API 인증 (메인 백엔드와 동일) =====
API_KEY=your-production-secret-key-here

# ===== GPU 설정 =====
FORCE_CUDA=True
MODEL_CACHE_DIR=./models

# ===== CORS (메인 백엔드 IP만 허용) =====
ALLOW_ORIGINS=["http://[MAIN_BACKEND_IP]:8000"]

# ===== 생성 기본값 =====
DEFAULT_STYLE=minimal
DEFAULT_ASPECT_RATIO=square
DEFAULT_NUM_INFERENCE_STEPS=30
DEFAULT_CONTROLNET_SCALE=1.0